    "bootstrap": "^5.3.7",
    "chart.js": "^4.5.0",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
